{
    "name": "mahocommerce/module-braintree",
    "description": "Braintree payment integration for Maho Commerce",
    "license": "OSL-3.0",
    "type": "maho-module",
    "require": {
        "braintree/braintree_php": "^6",
        "php": ">=8.5.1"
    },
    "conflict": {
        "mahocommerce/maho": "<26.11"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "*",
        "mahocommerce/maho": ">=26.11.1",
        "mahocommerce/maho-phpstan-plugin": "*",
        "phpstan/phpstan": "*",
        "phpstan/phpstan-deprecation-rules": "*",
        "phpstan/phpstan-strict-rules": "*",
        "rector/rector": "*",
        "pestphp/pest": "^5",
        "pestphp/pest-plugin-browser": "^5"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "mahocommerce/maho-composer-plugin": true,
            "php-http/discovery": false,
            "pestphp/pest-plugin": true
        },
        "platform": {
            "php": "8.5.1"
        }
    }
}
