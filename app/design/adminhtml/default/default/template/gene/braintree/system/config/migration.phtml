<script type="text/javascript">
    /**
     * Show or hide the text of the loading state
     *
     * @param {boolean} visible
     */
    function toggleMigrationLoadingText(visible) {
        document.querySelectorAll('.braintree-migration-loading h3, .braintree-migration-loading p').forEach(function (element) {
            element.style.display = visible ? '' : 'none';
        });
    }

    /**
     * Show the migration
     *
     * @returns {boolean}
     */
    function showMigration() {
        toggleMigrationLoadingText(true);
        document.getElementById('braintree-migration').classList.remove('loading');

        document.getElementById('braintree-migration-overlay').classList.add('active');
        document.getElementById('braintree-migration').classList.add('active');
        return false;
    }

    /**
     * Automatically check the order transaction info box if they opt to remove the legacy module
     *
     * @returns {boolean}
     */
    function checkTransactionIsChecked() {
        if (document.getElementById('remove-legacy').checked) {
            document.getElementById('order-transaction-info').checked = true;
        }
    }

    // Migration submit action
    document.querySelector('.braintree-migration-content').addEventListener('submit', function (event) {
        event.preventDefault();
        var form = event.currentTarget;

        // Set the class name to loading to change the UI
        document.getElementById('braintree-migration').classList.add('loading');

        mahoFetch(form.getAttribute('action'), {method: 'post', body: new FormData(form), loaderArea: false})
            .then(function (response) {
                if (response && response.success === true) {
                    // The migration was a success, reload the page
                    location.reload();
                }
            })
            .catch(function () {
                alert('<?php echo $this->jsQuoteEscape($this->__('An issue has occurred whilst running the migration, please contact a member of support.')); ?>');
            });
    });

    // Cancel action
    document.querySelector('.gene-migration-cancel').addEventListener('click', function (event) {
        event.preventDefault();

        // Show a loading state
        toggleMigrationLoadingText(false);
        document.getElementById('braintree-migration').classList.add('loading');

        mahoFetch('<?php echo Mage::helper('adminhtml')->getUrl('adminhtml/braintree_migration/cancel'); ?>', {loaderArea: false})
            .then(function (response) {
                if (response && response.success === true) {
                    document.getElementById('braintree-migration-overlay').classList.remove('active');
                    document.getElementById('braintree-migration').classList.remove('active');
                }
            })
            .catch(function () {
                alert('<?php echo $this->jsQuoteEscape($this->__('An issue has occurred whilst cancelling the migration, please contact a member of support.')); ?>');
            });
    });
</script>
